{
  "name": "rr-web-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0 <21"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "db:migrate:status": "prisma migrate status",
    "db:predeploy": "prisma validate && prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:ensure-test-manager": "tsx prisma/ensure-test-manager.ts",
    "db:purge:sports": "tsx prisma/purge-sports.ts",
    "db:bootstrap:initial": "tsx prisma/bootstrap-initial.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.8.0",
    "@prisma/client": "7.8.0",
    "@tailwindcss/postcss": "^4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "mariadb": "^3.5.2",
    "next": "^16.2.12",
    "next-auth": "^4.24.14",
    "prisma": "7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
